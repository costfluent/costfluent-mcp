{
  "inputs": [
    {
      "type": "promptString",
      "id": "costfluent-api-token",
      "description": "Costfluent API token",
      "password": true
    }
  ],
  "servers": {
    "costfluent": {
      "type": "stdio",
      "command": "/opt/costfluent/bin/costfluent-mcp",
      "args": [],
      "env": {
        "COSTFLUENT_API_TOKEN": "${input:costfluent-api-token}"
      }
    }
  }
}
